{
  "manifest_version": 3,
  "name": "iBay Plus",
  "description": "Extra powers for ibay.com.mv: local watchlist with notes, price tracking & drop alerts, keyword hiding/highlighting.",
  "version": "1.0.0",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "notifications", "alarms"],
  "host_permissions": ["https://ibay.com.mv/*", "https://www.ibay.com.mv/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "iBay Plus",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options/options.html",
  "content_scripts": [
    {
      "matches": ["https://ibay.com.mv/*", "https://www.ibay.com.mv/*"],
      "js": ["content/common.js", "content/listings.js"],
      "css": ["styles/content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://ibay.com.mv/*-o*.html*", "https://www.ibay.com.mv/*-o*.html*"],
      "js": ["content/common.js", "content/item.js"],
      "css": ["styles/content.css"],
      "run_at": "document_idle"
    }
  ]
}
